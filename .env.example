# Copy this file to .env and fill in your keys
# NEVER commit .env to git

# Required: Google Places API key
# Enable "Places API" in Google Cloud Console
GOOGLE_MAPS_API_KEY=

# Optional: OpenAI API key for AI-generated outreach
# Without this, outreach falls back to built-in templates
OPENAI_API_KEY=

# OpenAI model to use (default: gpt-4o-mini — cheap + fast)
OPENAI_MODEL=gpt-4o-mini

# Your name — appears in outreach messages
FOUNDER_NAME=Your Name

# HTTP timeout for website enrichment (seconds)
REQUEST_TIMEOUT=15

# Delay between Google Maps API requests (seconds)
RATE_LIMIT_SECONDS=1.2

# Default max results per search query
DEFAULT_MAX_RESULTS=60
